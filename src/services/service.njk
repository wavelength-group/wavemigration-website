---
layout: page.njk
pagination:
  data: services.items
  size: 1
  alias: svc
permalink: "/services/{{ svc.slug }}/index.html"
eleventyComputed:
  title: "{{ svc.title }}"
  description: "{{ svc.summary }}"
---
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/services/">Our services</a> &nbsp;/&nbsp; {{ svc.title }}</p>
      <h1>{{ svc.title }}</h1>
      <p class="lead">{{ svc.summary }}</p>
    </div>
  </section>
  <section style="padding-top:56px">
    <div class="wrap split-2">
      <div class="prose-block">
        {%- if svc.sections %}
        <p class="lead-in">{{ svc.intro }}</p>
        {%- for sec in svc.sections %}
        <h2>{{ sec.h }}</h2>
        {%- for para in sec.p %}
        <p>{{ para }}</p>
        {%- endfor %}
        {%- if sec.ul %}
        <ul class="prose-list">
          {%- for li in sec.ul %}
          <li>{{ li | safe }}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- endfor %}
        <p class="fine-note">General information only, not migration or legal advice. Requirements and timeframes change, so contact us for advice on your circumstances.</p>
        {%- else %}
        <div class="todo"><b>Content to come</b><span>The migration team will supply the full write-up for this page.</span></div>
        {%- endif %}
      </div>
      <aside class="side-card">
        <h3>Includes</h3>
        <ul>
          {%- for pt in svc.points %}
          <li>{{ pt }}</li>
          {%- endfor %}
        </ul>
        <a href="/contact/" class="btn btn-primary">Make an enquiry</a>
      </aside>
    </div>
  </section>
  {%- if svc.slug == "australian-visas-migration" %}
  <section style="padding-top:0">
    <div class="wrap">{% include "consult-box.njk" %}</div>
  </section>
  {%- endif %}
  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:24px"><h2 style="font-size:1.5rem">Other services</h2></div>
      <div class="svc-cards">
        {%- for s in services.items %}{% if s.slug != svc.slug %}
        <a class="svc-card" href="/services/{{ s.slug }}/">
          <h3>{{ s.title }}</h3>
          <p>{{ s.card or s.summary }}</p>
          <span class="go">Read more &rarr;</span>
        </a>
        {%- endif %}{% endfor %}
      </div>
    </div>
  </section>
{% include "cta-band.njk" %}
