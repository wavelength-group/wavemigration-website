---
layout: page.njk
pagination:
  data: services.items
  size: 1
  alias: svc
permalink: "/services/{{ svc.slug }}/index.html"
eleventyComputed:
  title: "{{ svc.title }}"
  description: "{{ svc.summary }}"
---
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/services/">Our services</a> &nbsp;/&nbsp; {{ svc.title }}</p>
      <h1>{{ svc.title }}</h1>
      <p class="lead">{{ svc.summary }}</p>
    </div>
  </section>
  <section style="padding-top:56px">
    <div class="wrap split-2">
      <div class="prose-block">
        <div class="todo"><b>Content to come</b><span>The migration team will supply the full write-up for this page: what the service is, who it is for, how the process works and typical timeframes.</span></div>
        <h2>What&rsquo;s involved</h2>
        <p>Placeholder text. A plain-English explanation of {{ svc.title | lower }} for doctors who have heard the term but are not sure what it means or whether it applies to them.</p>
        <h2>How we help</h2>
        <p>Placeholder text. How a dedicated in-house consultant manages the application from start to finish.</p>
      </div>
      <aside class="side-card">
        <h3>Includes</h3>
        <ul>
          {%- for pt in svc.points %}
          <li>{{ pt }}</li>
          {%- endfor %}
        </ul>
        <a href="/contact/" class="btn btn-primary">Make an enquiry</a>
      </aside>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:24px"><h2 style="font-size:1.5rem">Other services</h2></div>
      <div class="svc-cards">
        {%- for s in services.items %}{% if s.slug != svc.slug %}
        <a class="svc-card" href="/services/{{ s.slug }}/">
          <h3>{{ s.title }}</h3>
          <p>{{ s.summary }}</p>
          <span class="go">Read more &rarr;</span>
        </a>
        {%- endif %}{% endfor %}
      </div>
    </div>
  </section>
