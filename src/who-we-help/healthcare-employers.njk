<style>
  .emp-hero .btn{margin-top:28px}
  .emp-intro{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
  .emp-intro h2{font-size:clamp(1.8rem,3vw,2.4rem)}
  .emp-intro .sub{margin-top:10px;font-size:19px;font-weight:600;color:var(--teal-ink)}
  .emp-intro .txt{margin-top:16px;color:var(--muted);font-size:17px}
  .emp-photo{margin-top:28px;border-radius:20px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow-lg);aspect-ratio:16/10;background:var(--surface-2)}
  .emp-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .benefits{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:30px 30px 18px;box-shadow:var(--shadow)}
  .benefits h3{font-size:21px;margin-bottom:8px}
  .benefit{display:flex;gap:16px;align-items:flex-start;padding:16px 0;border-top:1px solid var(--line)}
  .benefits h3+.benefit{border-top:none}
  .b-ic,.t-ic{flex:none;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--aqua) 14%,var(--surface-2));color:var(--teal-ink)}
  .b-ic svg,.t-ic svg{width:22px;height:22px}
  .benefit b{display:block;font-size:16px;color:var(--ink)}
  .benefit p{margin-top:4px;font-size:14.5px;color:var(--muted)}
  .how-head{text-align:center;max-width:60ch;margin:0 auto 40px}
  .how-head h2{font-size:clamp(1.8rem,3vw,2.4rem)}
  .how-head p{margin-top:12px;color:var(--muted);font-size:17px}
  .how{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;counter-reset:how}
  .how-step{text-align:center;position:relative}
  .how-step .circle{position:relative;width:96px;height:96px;margin:0 auto;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--aqua) 14%,var(--surface-2));color:var(--teal-ink);border:1px solid var(--line-strong)}
  .how-step .circle svg{width:40px;height:40px}
  .how-step .n{position:absolute;top:-4px;left:-4px;width:32px;height:32px;border-radius:50%;background:var(--spark);color:var(--on-accent);font-weight:800;font-size:15px;display:grid;place-items:center}
  .how-step:not(:last-child)::after{content:"";position:absolute;top:48px;left:calc(50% + 62px);right:calc(-50% + 48px);border-top:2px dashed var(--line-strong)}
  .how-step h4{margin:20px 0 8px;font-size:17px}
  .how-step p{font-size:14.5px;color:var(--muted);max-width:26ch;margin:0 auto}
  .how-tag{margin:40px auto 0;display:table;padding:10px 22px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line-strong);font-weight:700;font-size:14.5px;color:var(--ink)}
  .wwd-head{max-width:62ch;margin-bottom:32px}
  .wwd-head h2{font-size:clamp(1.8rem,3vw,2.4rem);margin-top:14px}
  .wwd{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .wwd-tile{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:26px;display:grid;gap:12px;align-content:start;transition:border-color .2s,transform .2s}
  .wwd-tile:hover{border-color:var(--line-strong);transform:translateY(-2px)}
  .wwd-tile h3{font-size:18px}
  .wwd-tile p{font-size:15px;color:var(--muted)}
  .proof{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;align-items:stretch}
  .proof .stat-card{display:flex;flex-direction:column;justify-content:center}
  .quote-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:34px 34px 30px;box-shadow:var(--shadow);display:flex;flex-direction:column;justify-content:center}
  .quote-card .mark{font-size:64px;line-height:.6;color:var(--spark);font-weight:800;height:28px}
  .quote-card blockquote{margin:14px 0 0;font-size:18px;line-height:1.6;color:var(--ink)}
  .quote-card .who{margin-top:18px;font-weight:700;font-size:15px}
  .quote-card .src{font-size:13px;color:var(--muted);margin-top:2px}
  @media (max-width:980px){
    .emp-intro,.proof{grid-template-columns:1fr}
    .how{grid-template-columns:1fr 1fr;row-gap:40px}
    .how-step::after{display:none}
    .wwd{grid-template-columns:1fr 1fr}
  }
  @media (max-width:600px){
    .how,.wwd{grid-template-columns:1fr}
    .benefits{padding:24px 22px 12px}
  }
</style>
  <section class="page-head emp-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/who-we-help/">Who we help</a> &nbsp;/&nbsp; Healthcare employers</p>
      <h1>International healthcare recruitment, simplified.</h1>
      <p class="lead">Recruiting internationally trained healthcare professionals? We take care of the registration and migration so you can focus on building your workforce.</p>
      <a href="/contact/" class="btn btn-primary">Discuss your workforce needs <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </section>

  <section style="padding-top:64px">
    <div class="wrap emp-intro">
      <div>
        <p class="eyebrow">For health employers</p>
        <h2 style="margin-top:14px">One partner. The whole process.</h2>
        <p class="sub">Your international workforce, supported at every step.</p>
        <p class="txt">We coordinate the registration and migration requirements involved in bringing international healthcare professionals into your workforce. From AHPRA registration and specialist assessments to visa sponsorship and Medicare billing, we manage the entire process so you can focus on delivering healthcare.</p>
        <div class="emp-photo"><img src="/assets/img/employers-hospital.svg" alt="Clinicians walking together through a modern hospital foyer" loading="lazy" decoding="async"></div>
      </div>
      <div class="benefits">
        <h3>Why healthcare employers choose Wavelength</h3>
        {%- for b in benefits %}
        <div class="benefit">
          <span class="b-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{{ ic[b[0]] | safe }}</svg></span>
          <div><b>{{ b[1] | safe }}</b><p>{{ b[2] | safe }}</p></div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="how-head">
        <p class="eyebrow">Our process</p>
        <h2 style="margin-top:14px">How we work together</h2>
        <p>A simple, streamlined process to get your international healthcare professionals into your workforce.</p>
      </div>
      <div class="how">
        {%- for s in steps %}
        <div class="how-step">
          <div class="circle"><span class="n">{{ loop.index }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ ic[s[0]] | safe }}</svg></div>
          <h4>{{ s[1] }}</h4>
          <p>{{ s[2] }}</p>
        </div>
        {%- endfor %}
      </div>
      <p class="how-tag">Your international workforce. Our expertise.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="wwd-head">
        <p class="eyebrow">What we do</p>
        <h2>Everything you need to get your international workforce working</h2>
      </div>
      <div class="wwd">
        {%- for t in tiles %}
        <div class="wwd-tile">
          <span class="t-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{{ ic[t[0]] | safe }}</svg></span>
          <h3>{{ t[1] | safe }}</h3>
          <p>{{ t[2] }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap proof">
      <div class="stat-card">
        <div class="big">110<span class="plus">+</span></div>
        <div class="cap">employer nomination applications delivered for a single regional healthcare provider recruiting internationally.</div>
        <div class="rule"></div>
        <div class="foot">Proof that we scale, from one appointment to an entire workforce program.</div>
        <img class="cardmark" src="/assets/img/mark.svg" alt="">
      </div>
      <div class="quote-card">
        <div class="mark">&ldquo;</div>
        <blockquote>Elinor&rsquo;s knowledge and guidance made what can be a very complex process significantly easier to navigate. She has always been responsive, thorough and proactive, and we genuinely felt supported every step of the way.</blockquote>
        <div class="who">Gillian M., Bunbury and Busselton Eye Specialists</div>
        <div class="src">Google review &middot; SIMG recruitment and registration</div>
      </div>
    </div>
  </section>

