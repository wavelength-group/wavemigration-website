<script>
  (function(){
    // Dark theme only. Clear any light-mode choice saved by the old toggle.
    try{localStorage.removeItem('rms-theme');}catch(e){}
    var els=[].slice.call(document.querySelectorAll('.reveal'));
    if(!('IntersectionObserver' in window)||window.matchMedia('(prefers-reduced-motion:reduce)').matches){els.forEach(function(el){el.classList.add('in');});}
    else{var io=new IntersectionObserver(function(entries){entries.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}});},{threshold:.14});els.forEach(function(el){io.observe(el);});}
  })();
</script>
