<style>
  /* Lagoon Glow palette (Nov 2026). Dark is the default; light applies only when the visitor chooses it with the toggle. */
  :root{
    --ground:#032A2E;--surface:#08393D;--surface-2:#0E4549;--ink:#ECF7F7;--muted:#9CC4C5;
    --navy:#021E21;--navy-2:#073236;--indigo:#4FE3D4;--teal:#4FE3D4;--teal-deep:#7DEBDF;--teal-ink:#6BE8DB;
    --aqua:#4FE3D4;--pink:#4FE3D4;--pink-deep:#3CCFC0;--pink-ink:#6BE8DB;--spark:#FF9A45;--on-accent:#032A2E;
    --line:#164B4F;--line-strong:#245D61;--on-navy:#ECF7F7;--on-navy-mut:#9CC4C5;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px -16px rgba(0,0,0,.6);
    --shadow-lg:0 1px 2px rgba(0,0,0,.35),0 28px 64px -30px rgba(0,0,0,.75);
    --maxw:1140px;--r:14px;
    color-scheme:dark;
  }
  :root[data-theme="light"]{
    --ground:#F3F8F8;--surface:#FFFFFF;--surface-2:#E5F2F1;--ink:#0B2E31;--muted:#527073;
    --navy:#032A2E;--navy-2:#08393D;--indigo:#08807A;--teal:#08807A;--teal-deep:#066560;--teal-ink:#07706B;
    --aqua:#4FE3D4;--pink:#08807A;--pink-deep:#066560;--pink-ink:#07706B;--spark:#C9640F;--on-accent:#FFFFFF;
    --line:#DCE9E8;--line-strong:#C5D9D8;--on-navy:#ECF7F7;--on-navy-mut:#9CC4C5;
    --shadow:0 1px 2px rgba(3,42,46,.05),0 8px 28px -14px rgba(3,42,46,.22);
    --shadow-lg:0 1px 2px rgba(3,42,46,.06),0 26px 60px -28px rgba(3,42,46,.34);
    color-scheme:light;
  }

  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:"Public Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;font-size:17px;line-height:1.62;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  h1,h2,h3{font-family:inherit;font-weight:700;line-height:1.12;letter-spacing:-.02em;text-wrap:balance;margin:0}
  p{margin:0}
  a{color:var(--teal-ink);text-decoration:none}
  a:hover{text-decoration:underline;text-underline-offset:3px}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 26px}
  .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--indigo);display:inline-flex;align-items:center;gap:9px}
  section{padding:96px 0}
  .lead{font-size:19px;color:var(--muted);max-width:64ch}

  /* logo */
  .logo{display:inline-flex;align-items:center}
  .logo .l{height:44px;width:auto;display:block}
  .logo .l-light{display:none}
  :root[data-theme="light"] .logo .l-light{display:block}
  :root[data-theme="light"] .logo .l-dark{display:none}

  /* header */
  header.site{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--ground) 85%,transparent);backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;gap:20px;height:76px}
  .nav-links{display:flex;align-items:center;gap:26px}
  .nav-links a{color:var(--muted);font-size:14.5px;font-weight:600;white-space:nowrap}
  .nav-links a:hover{color:var(--ink);text-decoration:none}
  .nav-right{display:flex;align-items:center;gap:14px}
  .nav-right .t-sm{display:none}
  .btn{display:inline-flex;align-items:center;gap:9px;justify-content:center;font-family:"Public Sans",sans-serif;font-weight:700;font-size:15px;letter-spacing:.01em;padding:12px 22px;border-radius:999px;cursor:pointer;border:1px solid transparent;transition:transform .15s ease,background .2s ease,box-shadow .2s ease,color .2s ease;white-space:nowrap}
  .btn-primary{background:var(--teal);color:var(--on-accent);box-shadow:0 8px 20px -10px var(--teal)}
  .btn-primary:hover{background:var(--teal-deep);color:var(--on-accent);text-decoration:none;transform:translateY(-1px)}
  .btn-ghost{background:transparent;color:var(--ink);border-color:var(--line-strong)}
  .btn-ghost:hover{background:var(--surface-2);text-decoration:none}
  .hero .btn-ghost{background:#FFFFFF;color:#032A2E;border-color:#FFFFFF}
  .hero .btn-ghost:hover{background:#E6F4F3;border-color:#E6F4F3;color:#032A2E;transform:translateY(-1px)}
  :root[data-theme="light"] .hero .btn-ghost{border-color:var(--line-strong)}
  .btn-on-dark{background:var(--aqua);color:var(--navy)}
  .btn-on-dark:hover{background:#7DEBDF;text-decoration:none;transform:translateY(-1px)}
  .btn-outline-dark{background:transparent;color:var(--on-navy);border-color:rgba(169,170,208,.42)}
  .btn-outline-dark:hover{background:rgba(255,255,255,.07);text-decoration:none}
  .theme-toggle{width:40px;height:40px;border-radius:999px;border:1px solid var(--line-strong);background:var(--surface);color:var(--ink);cursor:pointer;display:grid;place-items:center;padding:0;transition:background .2s}
  .theme-toggle:hover{background:var(--surface-2)}
  .theme-toggle svg{width:18px;height:18px}
  .theme-toggle .sun{display:none}
  :root[data-theme="light"] .theme-toggle .sun{display:block}
  :root[data-theme="light"] .theme-toggle .moon{display:none}

  /* hero */
  .hero{position:relative;background:linear-gradient(180deg,var(--surface),var(--ground));color:var(--ink);overflow:hidden;padding:104px 0 116px;border-bottom:1px solid var(--line)}
  .hero .wrap{position:relative;z-index:2}
  .hero-bg{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
  .hero-mark{display:none}
  .hero-bg::before{content:"";position:absolute;top:0;right:0;bottom:0;width:62%;background:url(/assets/img/hero-passport.svg) calc(100% + 240px) center/cover no-repeat;opacity:.26;-webkit-mask-image:linear-gradient(to right,transparent 0%,#000 55%),linear-gradient(to bottom,#000 70%,transparent 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to right,transparent 0%,#000 55%),linear-gradient(to bottom,#000 70%,transparent 100%);mask-composite:intersect}
  :root[data-theme="light"] .hero-bg::before{opacity:.14;mix-blend-mode:multiply}
  @media (max-width:760px){.hero-bg::before{width:100%;opacity:.14}}
  .hero-diag{position:absolute;right:0;bottom:0;width:60%;height:100%}
  .hero-diag path:nth-child(1){stroke:var(--spark)}
  .hero-diag path:nth-child(2),.hero-diag path:nth-child(3){stroke:var(--aqua)}
  .hero-glow{position:absolute;z-index:1;width:640px;height:640px;right:-150px;top:-230px;background:radial-gradient(circle,rgba(79,227,212,.16),transparent 64%);pointer-events:none}
  .hero-eyebrow{color:var(--pink)}
  .hero h1{font-size:clamp(2.3rem,4.8vw,3.6rem);font-weight:800;letter-spacing:-.03em;line-height:1.06;color:var(--ink);max-width:16ch;margin:14px 0 0}
  .hero h1 .accent{color:var(--pink);font-style:italic}
  .hero p.sub{margin:24px 0 0;font-size:19px;color:var(--muted);max-width:58ch}
  .hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:38px}
  .hero-meta{display:flex;flex-wrap:wrap;gap:26px 40px;margin-top:52px;padding-top:30px;border-top:1px solid var(--line)}
  .hero-meta .item .n{font-weight:800;letter-spacing:-.02em;font-size:34px;color:var(--spark);line-height:1;font-variant-numeric:tabular-nums}
  .hero-meta .item .l{font-size:13.5px;color:var(--muted);margin-top:8px;max-width:22ch}

  /* audience split */
  .split{margin-top:-64px;position:relative;z-index:5}
  .split .wrap{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .aud-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:34px 32px;box-shadow:var(--shadow-lg);display:flex;flex-direction:column;gap:14px;transition:transform .2s ease}
  .aud-card:hover{transform:translateY(-3px)}
  .aud-card .tag{font-size:12.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--indigo)}
  .aud-card h3{font-size:24px}
  .aud-card p{color:var(--muted);font-size:16px}
  .aud-icon{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;background:var(--surface-2);color:var(--indigo);margin-bottom:4px}
  .aud-icon svg{width:26px;height:26px}
  .aud-card .go{margin-top:auto;font-weight:700;color:var(--teal-ink);display:inline-flex;align-items:center;gap:8px;font-size:15px}
  .aud-card:hover .go{gap:12px}
  .aud-card .go svg{width:16px;height:16px;transition:transform .2s}

  .sec-head{max-width:60ch;margin-bottom:44px}
  .sec-head h2{font-size:clamp(1.85rem,3.2vw,2.5rem);margin:16px 0 0}
  .sec-head p{margin-top:16px;color:var(--muted);font-size:18px}

  /* service blocks */
  .service{display:grid;grid-template-columns:0.9fr 1.1fr;gap:56px;align-items:start}
  .service.rev{grid-template-columns:1.1fr 0.9fr}
  .service.rev .s-copy{order:2}
  .panel-note{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:26px 28px}
  .service h2{font-size:clamp(1.75rem,3vw,2.3rem);margin-top:14px}
  .service .lead{margin-top:18px}
  .svc-list{list-style:none;padding:0;margin:22px 0 0;display:grid;gap:0}
  .svc-list li{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-top:1px solid var(--line);font-size:15.5px}
  .svc-list li:first-child{border-top:none}
  .svc-list .ic{flex:none;width:22px;height:22px;border-radius:6px;background:var(--surface-2);color:var(--indigo);display:grid;place-items:center;margin-top:1px}
  .svc-list .ic svg{width:13px;height:13px}
  .svc-list li b{font-weight:700;color:var(--ink)}
  .svc-list li span{color:var(--muted)}
  .stat-card{background:linear-gradient(155deg,var(--navy),var(--navy-2));color:var(--on-navy);border-radius:18px;padding:34px 32px;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
  .stat-card .big{font-weight:800;letter-spacing:-.03em;font-size:60px;line-height:.95;color:#fff;font-variant-numeric:tabular-nums}
  .stat-card .big .plus{color:var(--aqua)}
  .stat-card .cap{margin-top:14px;color:var(--on-navy-mut);font-size:16px;max-width:34ch}
  .stat-card .rule{height:1px;background:rgba(169,170,208,.26);margin:24px 0}
  .stat-card .foot{font-size:13.5px;color:var(--on-navy-mut);letter-spacing:.03em}
  .stat-card .cardmark{position:absolute;right:-24px;bottom:-24px;width:140px;height:140px;opacity:.16;transform:rotate(-8deg);display:block}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .chip{font-size:13px;font-weight:600;color:var(--indigo);background:var(--surface-2);border:1px solid var(--line);padding:7px 13px;border-radius:999px}

  .band{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}

  /* process */
  .steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:8px}
  .step{position:relative;padding:30px 22px 26px 0}
  .step .num{font-weight:700;font-size:15px;color:var(--indigo);width:40px;height:40px;border-radius:50%;border:1.5px solid var(--line-strong);display:grid;place-items:center;background:var(--surface);position:relative;z-index:2;font-variant-numeric:tabular-nums}
  .step::before{content:"";position:absolute;top:calc(30px + 20px);left:20px;right:-1px;height:2px;background:var(--line);z-index:1}
  .step:last-child::before{display:none}
  .step h4{font-family:"Public Sans",sans-serif;font-size:16px;font-weight:700;margin:18px 0 8px;letter-spacing:-.005em}
  .step p{font-size:14.5px;color:var(--muted)}

  /* why grid */
  .why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .why{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:26px 24px;box-shadow:var(--shadow)}
  .why .ic{width:42px;height:42px;border-radius:11px;background:var(--surface-2);color:var(--indigo);display:grid;place-items:center;margin-bottom:16px}
  .why .ic svg{width:22px;height:22px}
  .why h4{font-family:"Public Sans",sans-serif;font-size:16.5px;font-weight:700;margin:0 0 8px}
  .why p{font-size:14.5px;color:var(--muted)}

  /* about + team */
  .endorse{display:inline-flex;align-items:center;gap:10px;margin-top:22px;padding:11px 16px;background:var(--surface-2);border:1px solid var(--line);border-radius:999px;font-size:13.5px;color:var(--muted);font-weight:600}
  .endorse img{width:18px;height:18px;flex:none;display:block}
  .team{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:44px}
  .person{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:26px;box-shadow:var(--shadow-lg);display:flex;gap:22px}
  .person .pphoto{width:112px;height:112px;border-radius:50%;object-fit:cover;flex:none;border:1px solid var(--line);background:var(--surface-2)}
  .person .name{font-weight:700;font-size:20px;line-height:1.2;letter-spacing:-.01em}
  .person .role{color:var(--teal-ink);font-weight:700;font-size:13px;letter-spacing:.02em;margin-top:5px}
  .person .bio{color:var(--muted);font-size:14.5px;margin-top:12px}
  .person .cx{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px 16px}
  .person .cx a{display:inline-flex;align-items:center;gap:7px;color:var(--ink);font-size:13.5px;font-weight:600}
  .person .cx a:hover{color:var(--teal-ink);text-decoration:none}
  .person .cx a svg{width:15px;height:15px;color:var(--indigo)}

  /* testimonials */
  .tst-grid{columns:3 320px;column-gap:22px;margin-top:8px}
  .tst{break-inside:avoid;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px 24px 20px;box-shadow:var(--shadow);margin:0 0 22px}
  .tst .date{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:10px}
  .tst .stars{color:var(--spark);font-size:13px;letter-spacing:3px;margin-bottom:12px}
  .tst blockquote{margin:0;font-size:14.5px;color:var(--ink);line-height:1.62}
  .tst .by{margin-top:16px;padding-top:14px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline;gap:8px 14px;flex-wrap:wrap}
  .tst .by .who{font-weight:700;font-size:14px;color:var(--ink)}
  .tst .by .for{font-size:12.5px;color:var(--muted)}
  @media (max-width:520px){.tst-grid{columns:1}}

  /* contact */
  .contact{background:linear-gradient(120deg,var(--navy),var(--navy-2));color:var(--on-navy);border-radius:24px;padding:56px;position:relative;overflow:hidden}
  .contact .inner{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
  .contact h2{color:#fff;font-size:clamp(1.85rem,3.2vw,2.4rem)}
  .contact p{color:var(--on-navy-mut);margin-top:16px;font-size:17px}
  .contact .cta-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px}
  .contact-details{display:grid;gap:2px}
  .contact-details .row{display:flex;gap:14px;align-items:center;padding:16px 0;border-top:1px solid rgba(169,170,208,.22)}
  .contact-details .row:first-child{border-top:none}
  .contact-details .ic{width:40px;height:40px;border-radius:10px;background:rgba(79,227,212,.14);color:var(--aqua);display:grid;place-items:center;flex:none}
  .contact-details .ic svg{width:19px;height:19px}
  .contact-details .k{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--on-navy-mut)}
  .contact-details .v{color:#fff;font-weight:600;font-size:15.5px}
  .contact-details .v a{color:#fff}
  .contact .cardmark{position:absolute;right:-40px;top:-40px;width:220px;height:220px;opacity:.13;transform:rotate(-8deg);z-index:1;display:block}

  /* footer */
  footer.site{padding:52px 0 44px;border-top:1px solid var(--line)}
  .foot-grid{display:flex;justify-content:space-between;align-items:flex-start;gap:40px;flex-wrap:wrap}
  footer .logo .l{height:40px}
  .foot-links{display:flex;gap:28px;flex-wrap:wrap}
  .foot-links a{color:var(--muted);font-size:14px;font-weight:600}
  .foot-links a:hover{color:var(--ink);text-decoration:none}
  .foot-note{margin-top:34px;padding-top:24px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:13px;color:var(--muted)}
  .foot-note .disc{max-width:70ch}

  .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

  @media (max-width:920px){
    .service,.service.rev,.about,.contact .inner,.team{grid-template-columns:1fr;gap:34px}
    .service.rev .s-copy{order:0}
    .why-grid{grid-template-columns:1fr 1fr}
    .steps{grid-template-columns:1fr 1fr}
    .step::before{display:none}
    .team{gap:22px}
  }
  @media (max-width:1060px){.nav-links{display:none}}
  @media (max-width:760px){
    .split .wrap{grid-template-columns:1fr}
    .split{margin-top:-40px}
    section{padding:72px 0}
    .contact{padding:38px 26px}
    .hero{padding:88px 0 96px}
  }
  @media (max-width:520px){
    .why-grid,.steps{grid-template-columns:1fr}
    .hero-meta{gap:22px 30px}
    .person{flex-direction:column;gap:16px}
    .person .pphoto{width:96px;height:96px}
    .logo .l{height:34px}
    .nav{gap:12px;padding-left:18px;padding-right:18px}
    .nav-right{gap:10px}
    .nav-right .t-sm{display:inline}
    .nav-right .btn{padding-left:16px;padding-right:16px}
    .nav-right .t-lg{display:none}
  }
</style>
